# MySQL configuration
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=restaurant_db
MYSQL_USER=restaurant_user
MYSQL_PASSWORD=restaurant_pass

# JWT configuration
JWT_SECRET=change-this-to-a-long-random-development-secret-key
JWT_EXPIRATION_MS=86400000

# Internal Docker service URLs
AUTH_SERVICE_URL=http://auth:8081
QUEUE_SERVICE_URL=http://queue:8082
QUEUE_SERVICE_WS_URL=ws://queue:8082
VITE_API_PROXY_TARGET=http://gateway:8080

# Demo staff account
STAFF_SEED_ENABLED=true
STAFF_SEED_USERNAME=staff
STAFF_SEED_EMAIL=staff@redlantern.com
STAFF_SEED_PASSWORD=123456